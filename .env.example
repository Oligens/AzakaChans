# ============================================================
# AZAKA CHANS - Variables d'Environnement
# ============================================================
# Copiez ce fichier vers .env.local pour le développement.
# NE JAMAIS COMMITTER DE VALEURS RÉELLES OU DE SECRETS DANS GIT.
# En production, configurez ces variables dans Vercel.
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
APP_URL=https://azakachans.vercel.app
NODE_ENV=production
PORT=3000

# ============================================================
# BASE DE DONNÉES - NEON POSTGRESQL
# ============================================================
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_POOLED=

# ============================================================
# AUTHENTIFICATION
# ============================================================
JWT_SECRET=
SESSION_DURATION=86400
EMAIL_VERIFICATION_DURATION=600
MAX_VERIFICATION_ATTEMPTS=5

# ============================================================
# EMAIL - GMAIL SMTP / NODEMAILER
# ============================================================
# Pour le compte Gmail utilisé par AZAKA CHANS :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=adresse Gmail de l'application
# SMTP_PASS=mot de passe d'application Google (16 caractères)
# SMTP_FROM=adresse Gmail de l'expéditeur
# SMTP_SECURE=true pour le port 465; false pour le port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true

# ============================================================
# PAIEMENTS - MONCASH
# ============================================================
MONCASH_API_URL=https://moncash.digicelht.com/MoncashMboup/api
MONCASH_API_KEY=
MONCASH_API_SECRET=
MONCASH_CALLBACK_URL=https://azakachans.vercel.app/api/payments/moncash/callback

# ============================================================
# PAIEMENTS - NATCASH
# ============================================================
NATCASH_API_URL=
NATCASH_API_KEY=
NATCASH_API_SECRET=
NATCASH_CALLBACK_URL=https://azakachans.vercel.app/api/payments/natcash/callback

# ============================================================
# JACKPOT
# ============================================================
JACKPOT_AMOUNT=100000
JACKPOT_CATEGORIES=50,250,500,1000

# ============================================================
# SÉCURITÉ
# ============================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
CORS_ORIGINS=https://azakachans.vercel.app,http://localhost:3000
COOKIE_SECRET=

# ============================================================
# LOGGING ET MONITORING
# ============================================================
LOG_LEVEL=info
SENTRY_DSN=

# ============================================================
# STOCKAGE (optionnel)
# ============================================================
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ============================================================
# DÉVELOPPEMENT
# ============================================================
DEBUG=false
SQL_LOGGING=false

# ============================================================
# NOTES DE SÉCURITÉ
# ============================================================
# 1. Ne jamais mettre SMTP_PASS dans le code source.
# 2. Ne jamais utiliser VITE_SMTP_PASS : cela exposerait le secret au navigateur.
# 3. Utiliser exclusivement un mot de passe d'application Google pour Gmail SMTP.
# 4. Configurer SMTP_PASS comme variable secrète dans Vercel.
# 5. Après exposition accidentelle d'un mot de passe d'application, le révoquer et en générer un nouveau.
