# ============================================================
# AZAKA CHANS - Variables d'Environnement
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs
# NE JAMAIS COMMITTER LE FICHIER .env DANS GIT
# ============================================================

# ============================================================
# APPLICATION
# ============================================================

# URL de l'application (sans slash final)
APP_URL=https://azaka-chans.vercel.app

# Environnement (development, staging, production)
NODE_ENV=production

# Port de développement (local seulement)
PORT=3000

# ============================================================
# BASE DE DONNÉES - NEON POSTGRESQL
# ============================================================

# URL de connexion à la base de données Neon
# Format: postgresql://user:password@host:port/database?sslmode=require
# Récupérez cette URL depuis le tableau de bord Neon
DATABASE_URL=

# URL de connexion poolée (recommandée pour les fonctions serverless)
# Format: postgresql://user:password@host:port/database?sslmode=require&pgbouncer=true
DATABASE_URL_POOLED=

# ============================================================
# AUTHENTIFICATION
# ============================================================

# Secret pour signer les JWT (min 32 caractères, généré aléatoirement)
# Générez avec: openssl rand -base64 32
JWT_SECRET=

# Durée de validité des sessions (en secondes)
# Par défaut: 86400 (24 heures)
SESSION_DURATION=86400

# Durée de validité des codes de vérification email (en secondes)
# Par défaut: 600 (10 minutes)
EMAIL_VERIFICATION_DURATION=600

# Nombre maximum de tentatives de vérification
# Par défaut: 5
MAX_VERIFICATION_ATTEMPTS=5

# ============================================================
# ENVOI D'EMAIL
# ============================================================

# Service d'email (sendgrid, mailgun, ses, smtp)
EMAIL_PROVIDER=sendgrid

# Clé API du service d'email
EMAIL_API_KEY=

# Email expéditeur
EMAIL_FROM=noreply@azakachans.ht
EMAIL_FROM_NAME=AZAKA CHANS

# Configuration SMTP (si EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ============================================================
# PAIEMENTS - MONCASH
# ============================================================

# URL de l'API MonCash
MONCASH_API_URL=https://moncash.digicelht.com/MoncashMboup/api

# Clé API MonCash
MONCASH_API_KEY=

# Secret MonCash
MONCASH_API_SECRET=

# URL de callback MonCash (doit être HTTPS en production)
MONCASH_CALLBACK_URL=https://azaka-chans.vercel.app/api/payments/moncash/callback

# ============================================================
# PAIEMENTS - NATCASH
# ============================================================

# URL de l'API NatCash
NATCASH_API_URL=

# Clé API NatCash
NATCASH_API_KEY=

# Secret NatCash
NATCASH_API_SECRET=

# URL de callback NatCash (doit être HTTPS en production)
NATCASH_CALLBACK_URL=https://azaka-chans.vercel.app/api/payments/natcash/callback

# ============================================================
# JACKPOT
# ============================================================

# Montant du jackpot (en HTG)
JACKPOT_AMOUNT=100000

# Catégories de tickets éligibles au jackpot (séparées par des virgules)
JACKPOT_CATEGORIES=50,250,500,1000

# ============================================================
# SÉCURITÉ
# ============================================================

# Rate limiting (requêtes par minute par IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS origins autorisées (séparées par des virgules)
CORS_ORIGINS=https://azaka-chans.vercel.app,http://localhost:3000

# Clé secrète pour les cookies de session
COOKIE_SECRET=

# ============================================================
# LOGGING ET MONITORING
# ============================================================

# Niveau de log (debug, info, warn, error)
LOG_LEVEL=info

# Sentry DSN pour le monitoring d'erreurs (optionnel)
SENTRY_DSN=

# ============================================================
# STOCKAGE (optionnel)
# ============================================================

# URL du bucket de stockage (pour les uploads)
STORAGE_URL=

# Clé d'accès au stockage
STORAGE_ACCESS_KEY=

# Secret du stockage
STORAGE_SECRET_KEY=

# ============================================================
# VARIABLES DE DÉVELOPPEMENT
# ============================================================

# Mode débogage (true/false)
DEBUG=false

# Afficher les logs SQL (true/false)
SQL_LOGGING=false

# ============================================================
# NOTES IMPORTANTES
# ============================================================

# 1. NE JAMAIS committer ce fichier avec des valeurs réelles
# 2. Utilisez .env.local pour les variables locales (ignoré par git)
# 3. Configurez les variables dans Vercel Dashboard pour la production
# 4. Utilisez des valeurs différentes pour development et production
# 5. Rotinez régulièrement les secrets et clés API
# 6. Utilisez un gestionnaire de secrets pour la production (Vault, AWS Secrets Manager, etc.)
