{
  "id": "/",
  "name": "AZAKA",
  "short_name": "AZAKA",
  "description": "AZAKA — la plateforme de loterie haïtienne nouvelle génération. Rasin nou. Chans nou.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#07162E",
  "theme_color": "#0B4BC4",
  "lang": "fr",
  "categories": ["entertainment", "finance"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Boutique", "short_name": "Boutique", "url": "/boutique" },
    { "name": "Mon Portefeuille", "short_name": "Portefeuille", "url": "/portefeuille" },
    { "name": "Mes Tickets", "short_name": "Tickets", "url": "/mes-tickets" }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "protocol_handlers": [
    { "protocol": "web+azaka", "url": "/handle?data=%s" }
  ],
  "edge_side_panel": { "preferred_width": 400 }
}
